# ─────────────────────────────────────────────────────────────
# JARVIS configuration. Copy to `.env` and fill in your values.
# `.env` is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3000
# Required if JARVIS_HOST is not a loopback address. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_ACCESS_TOKEN=
# IANA time zone used for briefings, reminders and "today".
JARVIS_TIMEZONE=UTC
JARVIS_DB_PATH=./data/jarvis.db
# Your name, used in greetings (optional).
JARVIS_USER_NAME=

# --- AI engine ---
# One of: groq | openai | openai_compatible
AI_PROVIDER=groq
# Leave empty to use the provider default (groq: llama-3.3-70b-versatile, openai: gpt-4o-mini).
AI_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
# Only for AI_PROVIDER=openai_compatible (e.g. a local Ollama / LM Studio / vLLM server).
AI_BASE_URL=
AI_API_KEY=

# --- Integrations (Phase 5 — not implemented yet; listed so status is visible) ---
# Email (Gmail / Microsoft 365 via OAuth)
EMAIL_PROVIDER=
# Calendar (Google Calendar / Outlook via OAuth)
CALENDAR_PROVIDER=
# Web research (e.g. Tavily / Brave Search API)
RESEARCH_API_KEY=
