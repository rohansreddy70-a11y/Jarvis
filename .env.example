# ─────────────────────────────────────────────────────────────
# JARVIS configuration. Copy to `.env` and fill in your values.
# `.env` is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3000
# Required if JARVIS_HOST is not a loopback address. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_ACCESS_TOKEN=
# IANA time zone used for briefings, reminders and "today".
JARVIS_TIMEZONE=Asia/Kolkata
JARVIS_DB_PATH=./data/jarvis.db
# Your name, used in greetings (optional).
JARVIS_USER_NAME=

# --- AI engine ---
# One of: groq | openai | openai_compatible
AI_PROVIDER=groq
# Leave empty to use the provider default (groq: llama-3.3-70b-versatile, openai: gpt-4o-mini).
AI_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
# Only for AI_PROVIDER=openai_compatible (e.g. a local Ollama / LM Studio / vLLM server).
AI_BASE_URL=
AI_API_KEY=
# Speech-to-text model for WhatsApp voice notes. Default: groq → whisper-large-v3-turbo, openai → whisper-1.
AI_TRANSCRIBE_MODEL=

# --- Bedtime briefing ---
# Default time (24h, in JARVIS_TIMEZONE) for "tomorrow's schedule". Used only the
# first time JARVIS starts; afterwards change it on the Automations page.
JARVIS_BEDTIME_BRIEFING=21:30

# --- Reports ---
# Optional: pre-fills the recipient of the end-of-day manager update draft.
# The draft is never sent unless you approve it.
REPORT_MANAGER_EMAIL=

# --- Gmail (Google OAuth) — see docs/SETUP-GMAIL.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in your Google Cloud OAuth client.
# Default: http://127.0.0.1:3000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# --- WhatsApp notifications (Meta WhatsApp Cloud API) — see docs/SETUP-WHATSAPP.md ---
# Messages go ONLY to WHATSAPP_NOTIFY_TO (your own number).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your number with country code, digits only, e.g. 91XXXXXXXXXX
WHATSAPP_NOTIFY_TO=
# Approved template with ONE body variable {{1}} — required for messages sent
# more than 24h after you last messaged the business number (i.e. nightly briefings).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Two-way bot (message JARVIS from WhatsApp) — see Part 2 of the guide.
# Requires a public https address (e.g. Cloudflare Tunnel) AND JARVIS_ACCESS_TOKEN.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# true = allow approving sends/deletes by replying "APPROVE <id>" on WhatsApp.
WHATSAPP_ALLOW_APPROVALS=false

# --- Not built yet ---
RESEARCH_API_KEY=
